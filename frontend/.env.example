# ==============================================================================
# Akwaaba Homes — Frontend Environment Variables Configuration Template
# COPY THIS FILE TO .env.local AND CONFIGURE APPROPRIATELY
# DO NOT COMMIT THE ACTUAL .env.local FILE OR REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Backend API Root Endpoint (Must include /api/v1 prefix)
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Backend Socket.IO Server URL
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"

# Paystack Public Key for Client-Side Inline Popups
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_with_your_paystack_public_key"

# VAPID Public Key for Web Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace_with_vapid_public_key"
