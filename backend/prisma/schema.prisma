generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MODELS ---
model User {
  id            String  @id @default(uuid())
  email         String  @unique
  passwordHash  String
  role          String  @default("TENANT") // SQLite does not support enums
  firstName     String
  lastName      String
  otherNames    String?
  phoneNumber   String?
  gender        String?
  dateOfBirth   String?
  nationality   String?
  guardianName  String?
  guardianPhone String?
  avatarUrl     String?

  // School Information
  campus           String?
  studentId        String?
  dateOfAdmission  String?
  programmeOfStudy String?
  yearOfStudy      String?
  studentType      String?

  ghanaCardNumber        String?
  ghanaCardFrontUrl      String?
  ghanaCardBackUrl       String?
  ghanaCardStatus        String    @default("NOT_SUBMITTED") // SQLite does not support enums
  reputationScore        Float     @default(5.0)
  isEmailVerified        Boolean   @default(false)
  emailVerificationToken String?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  isSuspended            Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  properties      Property[]
  bookings        Booking[] // Bookings made (if tenant)
  reviews         Review[] // Reviews written
  notifications   Notification[] // In-app notifications
  sessions        Session[] // Active device sessions
  auditLogs       AuditLog[] // Actions performed by this user
  tickets         MaintenanceTicket[] @relation("TenantTickets")
  roommateProfile RoommateProfile?

  tenantBreaches   BreachReport[] @relation("TenantBreaches")
  reportedBreaches BreachReport[] @relation("ReporterBreaches")
  transactionsAsTenant   Transaction[] @relation("TenantTransactions")
  transactionsAsLandlord Transaction[] @relation("LandlordTransactions")

  @@index([role])
}

model Property {
  id             String   @id @default(uuid())
  landlordId     String
  landlord       User     @relation(fields: [landlordId], references: [id])
  title          String
  type           String   @default("Hostel") // Hostel, Homestay, Apartment
  description    String
  price          Float    @default(0) // Floor/min price, derived from rooms for search indexing
  location       String
  latitude       Float?
  longitude      Float?
  amenities      String // Store as JSON string
  images         String // Store as JSON string
  videoUrl       String?
  isAvailable    Boolean  @default(true)
  approvalStatus String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rooms        Room[]
  bookings     Booking[]
  tickets      MaintenanceTicket[] @relation("PropertyTickets")
  BreachReport BreachReport[]
  transactions Transaction[]
  subscription PropertySubscription?

  @@index([approvalStatus, isAvailable])
  @@index([location])
  @@index([type])
  @@index([price])
}

model Room {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType      String   // "1 in a room", "2 in a room", etc.
  bedsPerRoom   Int      @default(1) // Derived from roomType and stored explicitly
  numberOfRooms Int      @default(1) // How many rooms of this type exist
  price         Float    // Annual price for this room type in GHS
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings     Booking[]
  transactions Transaction[]

  @@index([propertyId])
}

model Booking {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     User     @relation(fields: [tenantId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId     String?  // Which specific room type was booked
  room       Room?    @relation(fields: [roomId], references: [id])
  startDate  DateTime
  endDate    DateTime
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  review         Review?
  leaseAgreement LeaseAgreement?
  transaction    Transaction?

  @@index([tenantId])
  @@index([status])
}

model LeaseAgreement {
  id                String    @id @default(uuid())
  bookingId         String    @unique
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenantSignature   String? // Base64 string
  landlordSignature String? // Base64 string
  tenantSignedAt    DateTime?
  tenantIpAddress   String?
  tenantUserAgent   String?
  landlordSignedAt  DateTime?
  landlordIpAddress String?
  landlordUserAgent String?
  cryptographicHash String?
  status            String    @default("PENDING_TENANT") // PENDING_TENANT, PENDING_LANDLORD, COMPLETED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Review {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id])
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  rating         Int // Constrained 1-5 in application logic
  comment        String?
  isFlagged      Boolean  @default(false) // Flagged for moderation
  isModerated    Boolean  @default(false) // Admin has reviewed this
  moderationNote String? // Admin note on moderation decision
  appealStatus   String   @default("NONE") // NONE, PENDING, ACCEPTED, REJECTED
  appealNote     String? // Tenant's appeal justification
  createdAt      DateTime @default(now())
}

model PropertySubscription {
  id               String   @id @default(uuid())
  propertyId       String   @unique
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  paymentReference String   @unique // Paystack/Hubtel reference ID
  paymentStatus    String   @default("PENDING") // PENDING, COMPLETED, FAILED
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // BOOKING, SUBSCRIPTION, PROPERTY, REVIEW, ANNOUNCEMENT
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String? // Optional deep-link (e.g., /dashboard/landlord)
  createdAt DateTime @default(now())
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  deviceFamily String?
  osFamily     String?
  lastActive   DateTime @default(now())
  expiresAt    DateTime
  isValid      Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  oldData   String? // JSON string
  newData   String? // JSON string
  ipAddress String?
  createdAt DateTime @default(now())
}

model Notice {
  id          String   @id @default(uuid())
  orderIndex  Int      @default(0)
  topLabel    String?
  title       String
  description String
  buttonText  String?
  buttonLink  String?
  iconType    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model MaintenanceTicket {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      User     @relation("TenantTickets", fields: [tenantId], references: [id])
  propertyId  String
  property    Property @relation("PropertyTickets", fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, REJECTED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  imageUrl    String? // Optional photo link
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RoommateProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  isActive    Boolean  @default(true)
  budget      Float
  cleanliness String // NEAT, AVERAGE, MESSY
  sleepHabits String // EARLY_BIRD, NIGHT_OWL
  studyHabits String // QUIET, SOCIAL
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- CHAT MODELS ---
model Conversation {
  id         String   @id @default(uuid())
  tenantId   String
  landlordId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]

  @@unique([tenantId, landlordId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model BreachReport {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         User     @relation("TenantBreaches", fields: [tenantId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User     @relation("ReporterBreaches", fields: [reporterId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title          String
  description    String
  status         String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  penaltyApplied Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      User     @relation("TenantTransactions", fields: [tenantId], references: [id])
  landlordId  String
  landlord    User     @relation("LandlordTransactions", fields: [landlordId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId      String?  // Which room type was involved
  room        Room?    @relation(fields: [roomId], references: [id])
  
  amount      Float
  reference   String   @unique // Paystack reference
  status      String   @default("SUCCESS") // SUCCESS, FAILED
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([landlordId])
  @@index([createdAt])
}
