# ==============================================================================
# Akwaaba Homes — Backend Environment Variables Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT-SPECIFIC CREDENTIALS
# DO NOT COMMIT THE ACTUAL .env FILE OR REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@localhost:5432/akwaaba_homes?schema=public"

# Cryptographic Keys (Must be high-entropy, minimum 32 characters in production)
JWT_SECRET="replace-with-a-cryptographically-secure-random-32-char-string"
REFRESH_JWT_SECRET="replace-with-a-different-cryptographically-secure-random-32-char-string"
ENCRYPTION_KEY="replace-with-64-character-hex-string-for-aes-256-encryption"

# Client Web Application Origins
FRONTEND_URL="http://localhost:3000"

# Financial Gateways — Paystack Ghana (MoMo & Card)
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_replace_with_your_paystack_public_key"

# Financial Gateways — Hubtel (Optional MoMo Fallback)
HUBTEL_CLIENT_ID="replace-with-hubtel-client-id"
HUBTEL_CLIENT_SECRET="replace-with-hubtel-client-secret"
HUBTEL_MERCHANT_ACCOUNT_NUMBER="replace-with-hubtel-merchant-account"

# Cloud Storage — Cloudinary (Identity Documents & Media)
CLOUDINARY_CLOUD_NAME="replace-with-cloudinary-cloud-name"
CLOUDINARY_API_KEY="replace-with-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"

# Transactional Email — SMTP (Verification & Reset Emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="security@akwaabahomes.com"
SMTP_PASS="replace-with-smtp-app-password"

# Business & Platform Economics
SUBSCRIPTION_FEE_GHS=100
PLATFORM_COMMISSION_PERCENT=5.0
